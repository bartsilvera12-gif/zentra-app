{
  "name": "zentra-movil",
  "version": "0.1.0",
  "private": true,
  "description": "Zentra Móvil — app móvil de ventas",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "empresa": "node scripts/empresa.mjs",
    "dev:lan": "next dev -H 0.0.0.0",
    "sync": "npm run build && npx cap sync",
    "android:init": "node scripts/android-init.mjs",
    "android": "npm run sync && npx cap open android",
    "test": "npm run test:directorio && npm run test:api && npm run test:nombre && npm run test:sin-ejemplo && npm run test:atras && npm run test:reportes && npm run test:colores && npm run test:grabador",
    "test:directorio": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --import ./test/hook.mjs test/directorio.mjs",
    "test:nombre": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --import ./test/hook.mjs test/nombre.mjs",
    "test:sin-ejemplo": "node test/sin-ejemplo.mjs",
    "test:colores": "node test/colores.mjs",
    "test:grabador": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --import ./test/hook.mjs test/grabador.mjs",
    "test:reportes": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --import ./test/hook.mjs test/reportes.mjs",
    "test:atras": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --import ./test/hook.mjs test/atras.mjs",
    "test:api": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --import ./test/hook.mjs test/api-erp.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "typescript": "5.9.2"
  }
}
