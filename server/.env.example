# Cobros de Zentra — plantilla de variables.
# Copiar a `server/.env` en la VPS y completar. NUNCA commitear el .env.

PORT=8790
# A que interfaz se asoma. 127.0.0.1 = solo el proxy de esta maquina llega.
# 0.0.0.0 solo si el proxy vive en otra red (contenedores) Y hay firewall.
HOST=127.0.0.1

# ── PagoPar ────────────────────────────────────────────────────────────────
# Del panel de PagoPar, en "Integrar con mi sitio web". Las de DESARROLLO se
# usan con PAGOPAR_ENV=staging; al pasar a produccion se reemplazan por las
# reales y se cambia PAGOPAR_ENV=production.
PAGOPAR_PUBLIC_KEY=
PAGOPAR_PRIVATE_KEY=

PAGOPAR_ENV=staging
PAGOPAR_STAGING_USE_OFFICIAL_HOSTS=1

# Cuantas horas tiene la persona para pagar antes de que el pedido caduque.
PAGOPAR_HORAS_PARA_PAGAR=48

# Item de catalogo. Placeholders validos que dejan pasar la transaccion.
PAGOPAR_ITEM_CATEGORIA=909
PAGOPAR_ITEM_CIUDAD=1
PAGOPAR_ITEM_PRODUCTO_ID=895
PAGOPAR_ITEM_IMAGEN_URL=

# ── Google Play ────────────────────────────────────────────────────────────
# Para verificar las compras hechas adentro de la app Android. Si falta algo
# de aca, /play/verificar contesta error y NO activa nada: un camino de pago
# que "funciona" sin poder verificar es peor que uno apagado.
#
# De la cuenta de servicio de Google Cloud (ver docs/COBROS.md): el correo que
# aparece en la credencial y el campo `private_key` del JSON. El JSON entero NO
# va al repositorio.
#
# El PEM tiene saltos de linea y un .env no: se pega con los saltos escritos
# como \n (entre comillas) o el PEM entero en base64. Las dos formas se
# aceptan.
PLAY_SERVICE_ACCOUNT_EMAIL=
PLAY_SERVICE_ACCOUNT_KEY=

# El paquete de la app Android. Una compra de otro paquete no es nuestra.
PLAY_PACKAGE_NAME=py.com.zentra.movil

# ── App Store ──────────────────────────────────────────────────────────────
# Para verificar las compras hechas adentro de la app iOS. Aca no hay
# credenciales que poner, y es a proposito: Apple entrega la transaccion ya
# firmada, y la firma se comprueba contra el certificado raiz de Apple, que es
# publico y esta en src/apple-root-ca-g3.pem. No hay secreto que rotar.
#
# El bundle de la app iOS nativa. OJO: NO es el mismo que el paquete de
# Android ni que el de la otra app iOS (la del WebView, que es
# py.com.zentra.movil). Si esto esta mal, TODAS las compras se rechazan con
# "esa compra no es de esta app" y no hay ninguna otra pista.
APPLE_BUNDLE_ID=py.com.zentra.movil.nativo

# NO PONER ESTO EN PRODUCCION. Reemplaza el certificado raiz de Apple, o sea
# que los comprobantes se comprueban contra una firma que no es de Apple:
# cualquiera se arma una cadena propia y se activa Max gratis. Existe solo
# para que test-apple.mjs pueda firmar comprobantes de mentira. Si esta
# puesta, el server lo grita al arrancar y /apple/health lo dice.
# APPLE_ROOT_CA_PEM=

# ── Supabase ───────────────────────────────────────────────────────────────
# Aca la persistencia NO es opcional: si no se puede escribir, no hay que
# cobrar. Un pago que entra sin quedar registrado es plata que nadie sabe de
# quien es.
#   SUPABASE_SERVICE_ROLE_KEY: clave service_role (SECRETA, nunca commitear)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=zentra

# ── CORS ───────────────────────────────────────────────────────────────────
# Desde donde se puede llamar a /pagopar/crear-cobro. Coma-separado.
# Vacio = sin filtro (solo para desarrollo).
ALLOWED_ORIGINS=

# ── Las paginas publicas ───────────────────────────────────────────────────
# Por donde escribe la gente desde /soporte, /privacidad y /eliminar-cuenta.
# Las tres paginas leen estas dos: si faltan, no fallan, muestran menos.
#
# Apple pide una URL de soporte y una forma de pedir la baja de la cuenta, y
# un pedido de baja conviene que quede por escrito: sin correo queda solo
# WhatsApp, que no deja registro de nada.
#
#   SOPORTE_WHATSAPP: solo digitos, con codigo de pais y sin +. Vacio esconde
#                     los enlaces a WhatsApp en vez de armar uno roto.
#   CONTACTO_EMAIL:   el correo que se muestra. Vacio esconde la linea.
SOPORTE_WHATSAPP=595973989068
CONTACTO_EMAIL=

# ── Solo para pruebas ──────────────────────────────────────────────────────
# Nada de esto va en produccion.
#
# Un cobro de monto chico para probar el circuito entero contra PagoPar de
# verdad. COBRO_PRUEBA_CLAVE es lo que hay que mandar para pedirlo: sin ella
# el modo esta apagado, que es como tiene que estar en la VPS.
# COBRO_PRUEBA_CLAVE=
# COBRO_PRUEBA_MONTO=1000

# A donde se le pregunta a cada pasarela. Existen para que las pruebas puedan
# apuntar a un servidor de mentira levantado en localhost. Sin estas, los
# tests saldrian a internet y dependerian de que Google y PagoPar contesten.
# PAGOPAR_API_BASE_URL=
# PAGOPAR_CHECKOUT_BASE_URL=
# PLAY_API_BASE_URL=
# PLAY_OAUTH_URL=
