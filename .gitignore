node_modules/
.next/
out/
build/
dist/

# Los proyectos nativos los genera Capacitor, así que no se versionan...
#
# Van con `/*` y no como `android/`: git no puede volver a incluir un archivo si
# un directorio padre está excluido —deja de recorrerlo y nunca llega a leer la
# excepción—. Escrito `android/`, los `!` de abajo eran decorativos: el
# google-services.json figuraba como ignorado y agregarlo pedía `-f`. Así, se
# ignora el contenido y se vuelve a abrir el camino nivel por nivel.
android/*
ios/*

# ...con una excepción: la configuración de Firebase no se regenera, se descarga
# de la consola. Si se pierde, la app deja de recibir notificaciones.
!android/app/
android/app/*
!android/app/google-services.json
!ios/App/
ios/App/*
!ios/App/App/
ios/App/App/*
!ios/App/App/GoogleService-Info.plist

*.tsbuildinfo
next-env.d.ts

.env*
!.env.example

.DS_Store
*.log
npm-debug.log*

# Variables de entorno locales
.env.local
.env*.local

# Copia temporal que usa scripts/android-init.mjs
.google-services.json.bak
