# Configuración de la app que va a las tiendas.
#
# Next la lee sola en `npm run build`. Está en el repositorio a propósito:
# vivía sólo en un `.env.local` de una máquina, esa máquina se borró, y la
# versión 16 salió en modo demostración —sin Supabase ni directorio de
# empresas— sin que nada avisara. Nadie podía entrar con su código de empresa.
#
# Nada de esto es secreto. Todo lo que empieza con NEXT_PUBLIC_ termina
# escrito adentro del APK, donde cualquiera lo puede leer: las claves de acá
# son las `anon`, que sólo dejan hacer lo que permiten las reglas de cada
# tabla. Las claves de verdad (service_role, Pagopar, Google) NUNCA van acá:
# viven en el .env del servidor de cobros.
#
# Un `.env.local` sigue ganándole a este archivo, para probar contra otra
# base sin tocarlo.

NEXT_PUBLIC_BACKEND=supabase

# La instalación pública: la de quien baja la app y se registra.
NEXT_PUBLIC_SUPABASE_URL=https://db-zentra.neura.com.py
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzkxMjA4NzQzLCJleHAiOjIxMDY1Njg3NDN9.GHxw4KAdCcKWMnUGzBqtTMP3gTJamLo1DJX3aAUg9Js

# Las empresas con ERP propio, por código. Agregar una pide armar la app de
# nuevo (ver `directorioJson` en src/lib/config.ts).
NEXT_PUBLIC_DIRECTORIO_JSON={"NEURA":{"nombre":"Neura Sistemas","supabaseUrl":"https://api.neura.com.py","anonKey":"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzc0MTAxNDYxLCJleHAiOjE5MzE3ODE0NjF9.7_wAph8IolPMXtgfpezSwS5XR62IdD__qhqCywLDp3Q","apiUrl":"https://sistemas.neura.com.py"}}

NEXT_PUBLIC_SOPORTE_WHATSAPP=595973989068
